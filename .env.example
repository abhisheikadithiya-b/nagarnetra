# ==============================================================================
# NagarNetra Urban Telemetry Grid - Environment Configuration Template
# Copy this file to .env and configure values before starting production services.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# Environment: development, testing, or production
ENVIRONMENT=development

# Service Metadata
PROJECT_NAME=NagarNetra Urban Telemetry Grid
VERSION=2.4.0
CITY_NAME=Bengaluru
DEFAULT_LAT=12.9716
DEFAULT_LON=77.5946

# Database & Storage
DATABASE_URL=sqlite:///./nagarnetra.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
EVIDENCE_DIR=./backend/app/data/evidence

# Security & Cryptography
JWT_SECRET_KEY=dev-jwt-secret-key-change-this-in-production-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
DEFAULT_HMAC_SECRET_KEY=dev-edge-fallback-hmac-key-2026
KEY_ROTATION_GRACE_PERIOD_SEC=86400
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_BODY_BYTES=1048576
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Fleet Verification Calibration
CLEAN_PASS_COUNT_REQUIRED=6
Z_AXIS_SHOCK_THRESHOLD=0.25
MAX_GPS_SPEED_KMH=130.0
TIMESTAMP_FRESHNESS_SEC=300

# Frontend Build Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/v1/live
NEXT_PUBLIC_DEFAULT_DATA_MODE=demo
